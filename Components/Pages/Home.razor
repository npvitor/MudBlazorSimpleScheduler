@page "/"

@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>MudBlazor Simple Scheduler</PageTitle>

<SimpleScheduler Events="_events"
                 @bind-StartDate="_startDate"
                 OpeningTime="Abertura"
                 ClosingTime="Encerramento"
                 SlotDurationMinutes="DuracaoLocacao"
                 OnSlotClick="CreateEventAsync"
                 OnEventClick="EditEventAsync" />

@code {
    public int DuracaoLocacao { get; set; } = 60;

    public TimeOnly Abertura { get; set; } = new TimeOnly(09, 00);
    public TimeOnly Encerramento { get; set; } = new TimeOnly(18, 00);

    private DateOnly? _startDate;

    List<SchedulerEvents> _events = new();

    protected override void OnInitialized()
    {
        // Dados de exemplo relativos a hoje, para a semana exibida nunca abrir vazia.
        // Em um projeto real, carregue os eventos do banco de dados aqui.
        var hoje = DateOnly.FromDateTime(DateTime.Today);

        _events = new List<SchedulerEvents>
        {
            new SchedulerEvents(){ Id = 1, Date = hoje, Time = new TimeOnly(13, 00), Description = "Vitor" },
            new SchedulerEvents(){ Id = 3, Date = hoje.AddDays(1), Time = new TimeOnly(15, 00), Description = "Junior" },
            new SchedulerEvents(){ Id = 4, Date = hoje.AddDays(8), Time = new TimeOnly(10, 00), Description = "Enryk" },
            new SchedulerEvents(){ Id = 5, Date = hoje.AddDays(3), Time = new TimeOnly(09, 00), Description = "Thales" },
            new SchedulerEvents(){ Id = 7, Date = hoje.AddDays(4), Time = new TimeOnly(12, 00), Description = "Chayene" },
            new SchedulerEvents(){ Id = 8, Date = hoje.AddDays(-7), Time = new TimeOnly(16, 00), Description = "Tulio" },
            new SchedulerEvents(){ Id = 9, Date = hoje.AddDays(6), Time = new TimeOnly(17, 00), Description = "Isac" },
        };
    }

    private async Task CreateEventAsync(SchedulerSlot slot)
    {
        var result = await ShowEventDialogAsync("Novo evento", slot.Date, slot.Time);

        if (result?.Description is not { } descricao)
            return;

        _events.Add(new SchedulerEvents()
        {
            Id = _events.Count == 0 ? 1 : _events.Max(x => x.Id) + 1,
            Date = slot.Date,
            Time = slot.Time,
            Description = descricao
        });
    }

    private async Task EditEventAsync(SchedulerEvents schedulerEvent)
    {
        var result = await ShowEventDialogAsync("Editar evento", schedulerEvent.Date, schedulerEvent.Time, schedulerEvent.Description, permitirExcluir: true);

        if (result is null)
            return;

        if (result.Delete)
        {
            _events.Remove(schedulerEvent);
            Snackbar.Add("Evento excluído", Severity.Info);
        }
        else if (result.Description is { } descricao)
        {
            schedulerEvent.Description = descricao;
        }
    }

    private async Task<EventDialogResult?> ShowEventDialogAsync(string title, DateOnly date, TimeOnly time, string? descricao = null, bool permitirExcluir = false)
    {
        var dialogParameters = new DialogParameters<EventDialog>
        {
            { x => x.Data, date },
            { x => x.Time, time },
            { x => x.Descricao, descricao },
            { x => x.PermitirExcluir, permitirExcluir }
        };

        var dialog = await DialogService.ShowAsync<EventDialog>(title, dialogParameters, new DialogOptions() { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall });
        var result = await dialog.Result;

        return result is { Canceled: false, Data: EventDialogResult eventResult } ? eventResult : null;
    }
}
